<workout_file>
    <author>Sporterlay</author>
    <name>Sweet Spot 3x10</name>
    <description>Three 10-minute sweet spot efforts with 5 minutes easy between. 60 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <SteadyState Duration="120" Power="0.55"/>
        <SteadyState Duration="600" Power="0.90" Cadence="90"/>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.90" Cadence="90"/>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.92" Cadence="90"/>
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.40"/>
    </workout>
</workout_file>
