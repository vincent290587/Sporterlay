<workout_file>
    <author>Sporterlay</author>
    <name>VO2max 5x3</name>
    <description>Five 3-minute efforts at 115-120% FTP with 3 minutes recovery. 50 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="60" OnPower="1.05" OffPower="0.55" Cadence="100"/>
        <SteadyState Duration="180" Power="0.55"/>
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.18" OffPower="0.50" Cadence="100" CadenceResting="85"/>
        <Cooldown Duration="420" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
