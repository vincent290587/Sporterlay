<workout_file>
    <author>Sporterlay</author>
    <name>Quick Test 5min</name>
    <description>Short workout to check that ERG control works: target changes every 30-60 s.</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="60" Power="0.50"/>
        <SteadyState Duration="30" Power="0.80"/>
        <SteadyState Duration="30" Power="0.50"/>
        <Ramp Duration="60" PowerLow="0.50" PowerHigh="1.00"/>
        <SteadyState Duration="30" Power="0.60"/>
        <FreeRide Duration="60"/>
        <SteadyState Duration="30" Power="0.50"/>
    </workout>
</workout_file>
